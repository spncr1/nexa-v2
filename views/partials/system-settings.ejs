<!-- Three-icon settings command centre -->
<%- include("./feedback") %>

<div id="settings-backdrop" class="hidden" aria-hidden="true"></div>

<div id="profile-settings-modal" class="settings-modal hidden" role="dialog" aria-modal="true" aria-label="Profile Settings">
    <button type="button" class="settings-close-btn" aria-label="Close profile settings"><img class="app-icon" src="/client/shared/assets/Icons/close.svg" alt="" aria-hidden="true"></button>
    <div class="settings-layout">
        <aside class="settings-sidebar">
            <ul class="settings-sidebar-list">
                <li><button type="button" class="settings-nav" data-settings-target="profile" data-tab="profile">Profile</button></li>
                <li><button type="button" class="settings-nav" data-settings-target="profile" data-tab="security">Security</button></li>
                <li><button type="button" class="settings-nav" data-settings-target="profile" data-tab="account">Account</button></li>
            </ul>
        </aside>

        <div class="settings-content">
            <div class="settings-header">
                <img class="settings-brand-logo" src="/client/shared/assets/Images/nexa-v1.png" alt="" aria-hidden="true">
                <h3 class="settings-title">PROFILE SETTINGS</h3>
                <div id="profile-settings-subtitle" class="settings-subtitle">Profile</div>
            </div>

            <div class="settings-body">
                <div class="settings-panel" data-settings-panel="profile" data-panel="profile">
                    <div class="profile-avatar-row">
                        <button type="button" id="profile-avatar-preview" class="profile-avatar-preview" aria-label="Upload new profile picture">
                            <img class="app-icon profile-avatar-fallback" src="/client/shared/assets/Icons/profile.svg" alt="" aria-hidden="true">
                        </button>
                        <div class="profile-avatar-controls">
                            <button type="button" id="upload-avatar-btn" class="setting-file-btn"><span class="ui-btn-label">Upload</span><img class="app-icon" src="/client/shared/assets/Icons/upload.svg" alt="" aria-hidden="true"></button>
                            <input id="profile-avatar-input" class="hidden" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">
                            <button type="button" id="remove-avatar-btn" class="setting-action-btn danger"><span class="ui-btn-label">Remove</span><img class="app-icon" src="/client/shared/assets/Icons/cancel.svg" alt="" aria-hidden="true"></button>
                            <p id="profile-avatar-status" class="profile-avatar-status" aria-live="polite"></p>
                        </div>
                    </div>

                    <section class="profile-settings-group" aria-labelledby="profile-personal-heading">
                        <h4 id="profile-personal-heading" class="profile-settings-group-title">Personal information</h4>

                        <div class="setting-row">
                            <div class="setting-labels">Name</div>
                            <input type="text" id="account-name-input" class="setting-account-input">
                        </div>

                        <div class="setting-row">
                            <div class="setting-labels">Age</div>
                            <input type="number" id="account-age-input" class="setting-account-input" min="13" max="120" inputmode="numeric">
                        </div>

                        <div class="setting-row">
                            <div class="setting-labels">Email</div>
                            <input type="email" id="account-email-input" class="setting-account-input">
                        </div>

                        <div class="setting-row">
                            <div class="setting-labels">Location</div>
                            <input type="text" id="account-location-input" class="setting-account-input">
                        </div>
                    </section>

                    <section class="profile-settings-group" aria-labelledby="profile-academic-heading">
                        <h4 id="profile-academic-heading" class="profile-settings-group-title">Academic information</h4>

                        <div class="setting-row">
                            <div class="setting-labels">University</div>
                            <input type="text" id="account-university-input" class="setting-account-input">
                        </div>

                        <div class="setting-row">
                            <div class="setting-labels">Degree</div>
                            <input type="text" id="account-degree-input" class="setting-account-input">
                        </div>

                        <div class="setting-row profile-year-row">
                            <div class="setting-labels">Year level</div>
                            <div class="year-level-options" role="group" aria-label="Year level">
                                <button type="button" class="year-level-option" data-year-level="N/A">N/A</button>
                                <button type="button" class="year-level-option" data-year-level="1st year">1st year</button>
                                <button type="button" class="year-level-option" data-year-level="2nd year">2nd year</button>
                                <button type="button" class="year-level-option" data-year-level="3rd year">3rd year</button>
                                <button type="button" class="year-level-option" data-year-level="4th year">4th year</button>
                                <button type="button" class="year-level-option" data-year-level="5th year">5th year</button>
                            </div>
                        </div>

                        <div class="setting-row">
                            <div class="setting-labels">Semester</div>
                            <input type="text" id="account-semester-input" class="setting-account-input">
                        </div>
                    </section>

                    <div class="setting-row profile-save-row">
                        <div class="setting-labels">Save profile details</div>
                        <button type="button" id="save-profile-btn" class="setting-action-btn success"><span class="ui-btn-label">Save</span><img class="app-icon" src="/client/shared/assets/Icons/check.svg" alt="" aria-hidden="true"></button>
                    </div>
                    <p id="profile-settings-status" class="task-status" aria-live="polite"></p>
                </div>

                <div class="settings-panel hidden" data-settings-panel="profile" data-panel="security">
                    <div class="setting-row">
                        <div class="setting-labels">Current password</div>
                        <input type="password" id="current-password-input" class="setting-account-input" autocomplete="current-password">
                    </div>

                    <div class="setting-row">
                        <div class="setting-labels">New password</div>
                        <input type="password" id="new-password-input" class="setting-account-input" autocomplete="new-password">
                    </div>

                    <div class="setting-row">
                        <div class="setting-labels">Confirm password</div>
                        <input type="password" id="confirm-password-input" class="setting-account-input" autocomplete="new-password">
                    </div>

                    <p id="password-settings-status" class="task-status"></p>

                    <div class="setting-row">
                        <div class="setting-labels">Change password</div>
                        <button type="button" id="change-password-btn" class="setting-action-btn success"><span class="ui-btn-label">Update</span><img class="app-icon" src="/client/shared/assets/Icons/check.svg" alt="" aria-hidden="true"></button>
                    </div>
                </div>

                <div class="settings-panel hidden" data-settings-panel="profile" data-panel="account">
                    <div class="setting-row">
                        <div>
                            <div class="setting-labels">Delete account?</div>
                            <div class="setting-desc">Permanently removes this account and saved app data.</div>
                        </div>
                        <button type="button" id="delete-account-btn" class="setting-action-btn danger"><span class="ui-btn-label">Delete</span><img class="app-icon" src="/client/shared/assets/Icons/delete.svg" alt="" aria-hidden="true"></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="avatar-crop-modal" class="avatar-crop-modal hidden" role="dialog" aria-modal="true" aria-label="Crop profile picture">
    <button type="button" id="close-avatar-crop-btn" class="settings-close-btn" aria-label="Close crop tool"><img class="app-icon" src="/client/shared/assets/Icons/close.svg" alt="" aria-hidden="true"></button>
    <div class="avatar-crop-header">
        <img class="modal-brand-logo" src="/client/shared/assets/Images/nexa-v1.png" alt="" aria-hidden="true">
        <h3>Crop Picture</h3>
    </div>
    <div id="avatar-crop-frame" class="avatar-crop-frame">
        <img id="avatar-crop-image" alt="">
        <div class="avatar-crop-mask" aria-hidden="true"></div>
    </div>
    <label class="avatar-crop-zoom" for="avatar-crop-zoom">
        <span>Zoom</span>
        <input id="avatar-crop-zoom" type="range" min="1" max="3" step="0.01" value="1">
    </label>
    <p id="avatar-crop-status" class="avatar-crop-status" aria-live="polite"></p>
    <div class="avatar-crop-actions">
        <button type="button" id="cancel-avatar-crop-btn" class="btn-secondary is-neutral"><span class="ui-btn-label">Cancel</span><img class="app-icon" src="/client/shared/assets/Icons/cancel.svg" alt="" aria-hidden="true"></button>
        <button type="button" id="save-avatar-crop-btn" class="btn-secondary is-success"><span class="ui-btn-label">Save</span><img class="app-icon" src="/client/shared/assets/Icons/check.svg" alt="" aria-hidden="true"></button>
    </div>
</div>

<div id="system-settings-modal" class="settings-modal hidden" role="dialog" aria-modal="true" aria-label="System Settings">
    <button type="button" class="settings-close-btn" aria-label="Close system settings"><img class="app-icon" src="/client/shared/assets/Icons/close.svg" alt="" aria-hidden="true"></button>
    <div class="settings-layout">
        <aside class="settings-sidebar">
            <ul class="settings-sidebar-list">
                <li><button type="button" class="settings-nav" data-settings-target="system" data-tab="appearance">Appearance</button></li>
                <li><button type="button" class="settings-nav" data-settings-target="system" data-tab="preferences">Preferences</button></li>
                <li><button type="button" class="settings-nav" data-settings-target="system" data-tab="data">Data</button></li>
                <li><button type="button" class="settings-nav" data-settings-target="system" data-tab="about">About</button></li>
            </ul>
        </aside>

        <div class="settings-content">
            <div class="settings-header">
                <img class="settings-brand-logo" src="/client/shared/assets/Images/nexa-v1.png" alt="" aria-hidden="true">
                <h3 class="settings-title">SYSTEM SETTINGS</h3>
                <div id="system-settings-subtitle" class="settings-subtitle">Appearance</div>
            </div>

            <div class="settings-body">
                <div class="settings-panel" data-settings-panel="system" data-panel="appearance">
                    <div class="setting-row">
                        <div>
                            <div class="setting-labels">Theme mode</div>
                            <div class="setting-desc">Switch directly between light and dark.</div>
                        </div>

                        <button type="button" id="theme-switch" aria-label="Switch to dark mode" aria-pressed="false">
                            <img src="/client/shared/assets/Icons/dark-mode.svg" alt="" aria-hidden="true">
                            <img src="/client/shared/assets/Icons/light-mode.svg" alt="" aria-hidden="true">
                        </button>
                    </div>
                </div>

                <div class="settings-panel hidden" data-settings-panel="system" data-panel="preferences">
                    <section class="settings-preference-section" aria-labelledby="notifications-preferences-title">
                        <h4 id="notifications-preferences-title" class="settings-preference-heading">Notifications</h4>

                        <div class="setting-row">
                            <div>
                                <div class="setting-labels">Study timer alerts</div>
                                <div class="setting-desc">Allow an extra browser alert when a study timer ends.</div>
                            </div>
                            <label class="settings-toggle"><input type="checkbox" data-system-pref="studyTimerAlerts"><span></span></label>
                        </div>

                        <div class="setting-row">
                            <div>
                                <div class="setting-labels">Deadline reminders</div>
                                <div class="setting-desc">Choose how assignment reminders appear in Nexa.</div>
                            </div>
                            <select class="setting-account-input settings-select-compact" data-system-pref="deadlineReminderLevel">
                                <option value="important">Important only</option>
                                <option value="all">All upcoming</option>
                                <option value="off">Off</option>
                            </select>
                        </div>
                    </section>

                    <section class="settings-preference-section" aria-labelledby="tone-preferences-title">
                        <h4 id="tone-preferences-title" class="settings-preference-heading">App tone</h4>

                        <div class="setting-row setting-row-stacked">
                            <div>
                                <div class="setting-labels">Tone</div>
                                <div class="setting-desc">Adjust the style of empty states and light feedback copy.</div>
                            </div>
                            <div class="settings-segmented-control" role="group" aria-label="App tone" data-system-segmented-pref="appTone">
                                <button type="button" class="settings-segmented-option" data-pref-value="encouraging">Encouraging</button>
                                <button type="button" class="settings-segmented-option" data-pref-value="neutral">Neutral</button>
                                <button type="button" class="settings-segmented-option" data-pref-value="direct">Direct</button>
                            </div>
                        </div>
                    </section>

                    <section class="settings-preference-section" aria-labelledby="privacy-preferences-title">
                        <h4 id="privacy-preferences-title" class="settings-preference-heading">Privacy</h4>

                        <div class="setting-row">
                            <div>
                                <div class="setting-labels">Personalisation</div>
                                <div class="setting-desc">Remember layout and navigation preferences.</div>
                            </div>
                            <label class="settings-toggle"><input type="checkbox" data-system-pref="personalisation"><span></span></label>
                        </div>

                        <div class="setting-row">
                            <div>
                                <div class="setting-labels">Email reminders</div>
                                <div class="setting-desc">Send assignment reminder emails from the backend.</div>
                            </div>
                            <select class="setting-account-input settings-select-compact" data-system-pref="emailReminders">
                                <option value="off">Off</option>
                                <option value="important">Important only</option>
                                <option value="weekly">Weekly summary</option>
                            </select>
                        </div>

                        <div class="setting-row">
                            <div>
                                <div class="setting-labels">Send reminder email</div>
                                <div class="setting-desc">Send the current digest to your account email now.</div>
                            </div>
                            <button type="button" id="send-email-reminder-btn" class="setting-action-btn neutral"><span class="ui-btn-label">Send</span><img class="app-icon" src="/client/shared/assets/Icons/next.svg" alt="" aria-hidden="true"></button>
                        </div>
                        <p id="email-reminder-status" class="settings-preference-status hidden"></p>
                    </section>
                </div>

                <div class="settings-panel hidden" data-settings-panel="system" data-panel="data">
                    <div class="setting-row">
                        <div>
                            <div class="setting-labels">Reset app data?</div>
                            <div class="setting-desc">Clears tasks, subjects, assignments, profile fields, and preferences.</div>
                        </div>
                        <button type="button" id="reset-app-data-btn" class="setting-action-btn danger"><span class="ui-btn-label">Reset</span><img class="app-icon" src="/client/shared/assets/Icons/delete.svg" alt="" aria-hidden="true"></button>
                    </div>

                </div>

                <div class="settings-panel hidden" data-settings-panel="system" data-panel="about">
                    <div class="setting-row">
                        <div>
                            <div class="setting-labels">Help</div>
                            <div class="setting-desc">Need to update your profile or change the theme? Use the tabs on the left.</div>
                        </div>
                    </div>

                    <div class="setting-row">
                        <div>
                            <div class="setting-labels">About Nexa</div>
                            <div class="setting-desc">Version 1.2.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
