<div id="nexa-toast-region" class="nexa-toast-region" aria-live="polite" aria-atomic="true"></div>

<div id="nexa-confirm-backdrop" class="nexa-confirm-backdrop hidden" aria-hidden="true"></div>

<div id="nexa-confirm-dialog" class="nexa-confirm-dialog hidden" role="dialog" aria-modal="true" aria-labelledby="nexa-confirm-title" aria-describedby="nexa-confirm-message">
    <img class="modal-brand-logo" src="/client/shared/assets/Images/nexa-v1.png" alt="" aria-hidden="true">
    <h3 id="nexa-confirm-title" class="nexa-confirm-title"></h3>
    <p id="nexa-confirm-message" class="nexa-confirm-message"></p>

    <div class="nexa-confirm-actions">
        <button type="button" id="nexa-confirm-cancel" class="btn-secondary nexa-confirm-cancel"><span class="ui-btn-label">Cancel</span><img class="app-icon" src="/client/shared/assets/Icons/cancel.svg" alt="" aria-hidden="true"></button>
        <button type="button" id="nexa-confirm-accept" class="btn-secondary nexa-confirm-accept"><span class="ui-btn-label">OK</span><img class="app-icon" src="/client/shared/assets/Icons/check.svg" alt="" aria-hidden="true"></button>
    </div>
</div>
