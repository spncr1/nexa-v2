<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEXA - Confirm Email</title>

    <!-- CSS stylesheet -->
    <link rel="stylesheet" href="/client/shared/styles/auth.css">

    <!-- Primary Font (Headers & Titles - Manrope) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet">

    <!-- Secondary Font (Body Text - Noto Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/client/shared/assets/Images/nexa-v1.png">
</head>
<body>

    <main class="content">
        <% const verificationToken = typeof token !== 'undefined' ? token : ''; %>
        <% const verificationEmail = typeof email !== 'undefined' ? email : null; %>
        <% const alertError = typeof formError !== 'undefined' ? formError : null; %>
        <% const alertSuccess = typeof successMessage !== 'undefined' ? successMessage : null; %>
        <% const showVerifyForm = typeof canVerify !== 'undefined' ? canVerify : false; %>

        <img id="nexa-logo" src="/client/shared/assets/Images/nexa-v1.png">
        <h1>Confirm your email</h1>

        <% if (alertSuccess) { %>
            <p class="auth-status success"><%= alertSuccess %></p>
        <% } %>

        <% if (alertError) { %>
            <p class="auth-status error"><%= alertError %></p>
        <% } %>

        <% if (showVerifyForm) { %>
            <% if (verificationEmail) { %>
                <p>Finish creating the NEXA account for <%= verificationEmail %>.</p>
            <% } else { %>
                <p>Finish creating your NEXA account.</p>
            <% } %>

            <form class="auth-form verify-email-form" action="/verify-email/<%= verificationToken %>" method="POST" novalidate>
                <button type="submit">Confirm account</button>
            </form>
        <% } %>

        <div class="auth-footer">
            <a class="auth-link secondary" href="/register">Register again</a>
            <a class="auth-link" href="/login">Back to login</a>
        </div>
    </main>

</body>
</html>
