<!DOCTYPE html>
<html lang="en">
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>NEXA - Job Applications</title>

        <link rel="stylesheet" href="/client/features/JobApplications/job-applications.css">
        <link rel="stylesheet" href="/client/shared/styles/dark-mode.css">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

        <link rel="icon" type="image/png" href="/client/shared/assets/Images/nexa-v1.png">
    </head>
    <body>
        <script src="/client/shared/theme-boot.js"></script>

        <nav class="navbar">
            <div class="nav-brand">
                <div class="nav-brand-main">
                    <img class="nav-logo" src="/client/shared/assets/Images/nexa-v1.png" alt="" aria-hidden="true">
                    <span class="nav-title">NEXA</span>
                </div>

                <button class="menu-toggle" aria-label="Toggle navigation">
                    <img class="app-icon nav-item-icon" src="/client/shared/assets/Icons/menu.svg" alt="" aria-hidden="true">
                </button>
            </div>

            <ul class="nav-list">
                <li><a href="/" class="nav-item" aria-label="Home"><img class="app-icon nav-item-icon" src="/client/shared/assets/Icons/home.svg" alt="" aria-hidden="true"> <span class="nav-item-label">Home</span></a></li>
                <li>
                    <details class="nav-group">
                        <summary aria-label="Study"><span class="nav-summary-main"><img class="app-icon nav-summary-icon" src="/client/shared/assets/Icons/school.svg" alt="" aria-hidden="true"> <span class="nav-summary-label">Study</span></span><img class="app-icon nav-chevron" src="/client/shared/assets/Icons/next.svg" alt="" aria-hidden="true"></summary>
                        <ul class="nav-submenu">
                            <li><a href="/assignments">Assignments</a></li>
                            <li><a href="/study-planner">Study Planner</a></li>
                            <li><a href="/tasks">Tasks</a></li>
                        </ul>
                    </details>
                </li>
                <li>
                    <details class="nav-group">
                        <summary aria-label="Life"><span class="nav-summary-main"><img class="app-icon nav-summary-icon" src="/client/shared/assets/Icons/habits.svg" alt="" aria-hidden="true"> <span class="nav-summary-label">Life</span></span><img class="app-icon nav-chevron" src="/client/shared/assets/Icons/next.svg" alt="" aria-hidden="true"></summary>
                        <ul class="nav-submenu">
                            <li><a href="/habits">Habits</a></li>
                        </ul>
                    </details>
                </li>
                <li>
                    <details class="nav-group" open>
                        <summary class="active" aria-label="Career"><span class="nav-summary-main"><img class="app-icon nav-summary-icon" src="/client/shared/assets/Icons/career.svg" alt="" aria-hidden="true"> <span class="nav-summary-label">Career</span></span><img class="app-icon nav-chevron" src="/client/shared/assets/Icons/next.svg" alt="" aria-hidden="true"></summary>
                        <ul class="nav-submenu">
                            <li><a href="/job-applications" class="active">Job Applications</a></li>
                        </ul>
                    </details>
                </li>
                <li>
                    <details class="nav-group">
                        <summary aria-label="Financial"><span class="nav-summary-main"><img class="app-icon nav-summary-icon" src="/client/shared/assets/Icons/financial.svg" alt="" aria-hidden="true"> <span class="nav-summary-label">Financial</span></span><img class="app-icon nav-chevron" src="/client/shared/assets/Icons/next.svg" alt="" aria-hidden="true"></summary>
                        <ul class="nav-submenu">
                            <li><a href="/finances">Finances</a></li>
                        </ul>
                    </details>
                </li>
            </ul>
        </nav>

        <main class="content job-applications-page">
            <header class="jobs-header">
                <div>
                    <p class="jobs-kicker">Career Pipeline</p>
                    <h1 class="jobs-title">Job Applications</h1>
                    <p class="jobs-subtitle">Track applications, follow-ups, interviews, and offers without losing the thread.</p>
                </div>

                <button class="primary-action icon-add-btn job-add-btn" type="button" aria-label="New Application">
                    <span class="app-icon icon-add" aria-hidden="true"></span>
                </button>
            </header>

            <section class="category-tabs nx-card" aria-label="Application categories">
                <button class="category-tab is-active" type="button" data-category="swe">SWE Internships</button>
                <button class="category-tab" type="button" data-category="graduate">Graduate Roles</button>
                <button class="category-tab" type="button" data-category="part-time">Part-Time</button>
                <button class="category-tab" type="button" data-category="hospitality">Hospitality</button>
            </section>

            <section class="jobs-shell">
                <div class="jobs-main">
                    <section class="jobs-overview" aria-label="Application summary">
                        <article class="job-stat nx-card">
                            <span>Applications Sent</span>
                            <strong>28</strong>
                            <small>+4 this week</small>
                            <meter min="0" max="40" value="28">28 applications</meter>
                        </article>
                        <article class="job-stat nx-card">
                            <span>Awaiting Response</span>
                            <strong>11</strong>
                            <small>39% of total</small>
                            <meter min="0" max="28" value="11">11 awaiting response</meter>
                        </article>
                        <article class="job-stat nx-card">
                            <span>Interviews</span>
                            <strong>4</strong>
                            <small>14% of total</small>
                            <meter min="0" max="28" value="4">4 interviews</meter>
                        </article>
                        <article class="job-stat nx-card">
                            <span>Offers</span>
                            <strong>1</strong>
                            <small>4% of total</small>
                            <meter min="0" max="28" value="1">1 offer</meter>
                        </article>
                        <article class="status-mix nx-card">
                            <div class="card-heading">
                                <h2>Status Mix</h2>
                                <p>Current SWE pipeline.</p>
                            </div>
                            <div class="mix-body">
                                <div class="status-donut" aria-label="Applied 12, online assessment 7, interview 4, final stage 3, offer 1, rejected 1"></div>
                                <div class="mix-legend">
                                    <span><i class="mix-dot is-applied"></i>Applied <strong>12</strong></span>
                                    <span><i class="mix-dot is-oa"></i>OA <strong>7</strong></span>
                                    <span><i class="mix-dot is-interview"></i>Interview <strong>4</strong></span>
                                    <span><i class="mix-dot is-final"></i>Final Stage <strong>3</strong></span>
                                    <span><i class="mix-dot is-offer"></i>Offer <strong>1</strong></span>
                                    <span><i class="mix-dot is-rejected"></i>Rejected <strong>1</strong></span>
                                </div>
                            </div>
                        </article>
                    </section>

                    <article class="upcoming-actions nx-card" aria-labelledby="actions-title">
                        <div class="card-heading">
                            <div>
                                <h2 id="actions-title">Upcoming Actions</h2>
                                <p>The next best things to move forward.</p>
                            </div>
                            <button class="ghost-link" type="button">View all</button>
                        </div>

                        <div class="action-list">
                            <article class="action-item nx-card">
                                <div>
                                    <strong>Complete HireVue — CBA</strong>
                                    <span>Online assessment</span>
                                </div>
                                <time>Due Friday</time>
                                <span class="priority-badge priority-high">High Priority</span>
                                <button class="secondary-action" type="button">Create Task</button>
                            </article>
                            <article class="action-item nx-card">
                                <div>
                                    <strong>Interview prep — Hudl</strong>
                                    <span>Technical interview</span>
                                </div>
                                <time>Wed 3:00 PM</time>
                                <span class="priority-badge priority-medium">Medium</span>
                                <button class="secondary-action" type="button">Create Task</button>
                            </article>
                            <article class="action-item nx-card">
                                <div>
                                    <strong>Follow up with recruiter — Canva</strong>
                                    <span>Recruiter follow-up</span>
                                </div>
                                <time>Tomorrow</time>
                                <span class="priority-badge priority-low">Low</span>
                                <button class="secondary-action" type="button">Create Task</button>
                            </article>
                        </div>
                    </article>

                    <article class="applications-database nx-card" aria-labelledby="database-title">
                        <div class="database-head">
                            <div class="card-heading">
                                <div>
                                    <h2 id="database-title">Applications Database</h2>
                                    <p id="database-subtitle">SWE Internships</p>
                                </div>
                            </div>

                            <div class="database-tools">
                                <label class="search-field">
                                    <span>Search applications</span>
                                    <input id="application-search" type="search" placeholder="Search applications...">
                                </label>
                                <label class="filter-field">
                                    <span>Status filter</span>
                                    <select id="status-filter">
                                        <option value="all">All statuses</option>
                                        <option value="applied">Applied</option>
                                        <option value="oa">OA</option>
                                        <option value="interview">Interview</option>
                                        <option value="final">Final Stage</option>
                                        <option value="offer">Offer</option>
                                        <option value="rejected">Rejected</option>
                                    </select>
                                </label>
                            </div>
                        </div>

                        <div class="applications-table-wrap">
                            <table class="applications-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Company</th>
                                        <th scope="col">Role</th>
                                        <th scope="col">Location</th>
                                        <th scope="col">Date Applied</th>
                                        <th scope="col">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="applications-body">
                                    <tr data-category="swe" data-status="applied">
                                        <td><span class="company-avatar">AT</span><div><strong>Atlassian</strong><small>Saved in SWE</small></div></td>
                                        <td>Software Engineering Intern</td>
                                        <td>Sydney, Australia</td>
                                        <td>May 19, 2025</td>
                                        <td><span class="status-badge status-applied">Applied</span></td>
                                    </tr>
                                    <tr data-category="swe" data-status="oa">
                                        <td><span class="company-avatar">CA</span><div><strong>Canva</strong><small>Follow-up due</small></div></td>
                                        <td>Software Engineering Intern</td>
                                        <td>Sydney, Australia</td>
                                        <td>May 18, 2025</td>
                                        <td><span class="status-badge status-oa">OA</span></td>
                                    </tr>
                                    <tr data-category="swe" data-status="interview">
                                        <td><span class="company-avatar">CB</span><div><strong>CBA</strong><small>HireVue pending</small></div></td>
                                        <td>Technology Intern</td>
                                        <td>Melbourne, Australia</td>
                                        <td>May 16, 2025</td>
                                        <td><span class="status-badge status-interview">Interview</span></td>
                                    </tr>
                                    <tr data-category="swe" data-status="oa">
                                        <td><span class="company-avatar">OP</span><div><strong>Optus</strong><small>Assessment added</small></div></td>
                                        <td>Software Engineering Intern</td>
                                        <td>Sydney, Australia</td>
                                        <td>May 15, 2025</td>
                                        <td><span class="status-badge status-oa">OA</span></td>
                                    </tr>
                                    <tr data-category="swe" data-status="final">
                                        <td><span class="company-avatar">HU</span><div><strong>Hudl</strong><small>Final interview prep</small></div></td>
                                        <td>Software Engineer Intern</td>
                                        <td>Remote</td>
                                        <td>May 14, 2025</td>
                                        <td><span class="status-badge status-final">Final Stage</span></td>
                                    </tr>
                                    <tr data-category="graduate" data-status="offer">
                                        <td><span class="company-avatar">RE</span><div><strong>REA Group</strong><small>Graduate list</small></div></td>
                                        <td>Graduate Developer</td>
                                        <td>Melbourne, Australia</td>
                                        <td>May 10, 2025</td>
                                        <td><span class="status-badge status-offer">Offer</span></td>
                                    </tr>
                                    <tr data-category="part-time" data-status="applied">
                                        <td><span class="company-avatar">UN</span><div><strong>Uni Library</strong><small>Part-time list</small></div></td>
                                        <td>Student Assistant</td>
                                        <td>Campus</td>
                                        <td>May 9, 2025</td>
                                        <td><span class="status-badge status-applied">Applied</span></td>
                                    </tr>
                                    <tr data-category="hospitality" data-status="rejected">
                                        <td><span class="company-avatar">BR</span><div><strong>Bean Room</strong><small>Hospitality list</small></div></td>
                                        <td>Barista</td>
                                        <td>Newtown</td>
                                        <td>May 7, 2025</td>
                                        <td><span class="status-badge status-rejected">Rejected</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <p class="table-footer" id="database-count">Showing 1-5 of 28</p>
                    </article>
                </div>

                <aside class="jobs-sidebar" aria-label="Application utilities">
                    <article class="task-suggestions nx-card">
                        <div class="card-heading">
                            <div>
                                <h2>Task Suggestions</h2>
                                <p>Turn application updates into next steps.</p>
                            </div>
                        </div>

                        <article class="suggestion-row nx-card">
                            <div>
                                <strong>New OA added</strong>
                                <span>Optus — Software Engineering Intern</span>
                            </div>
                            <button class="secondary-action" type="button">Create Task</button>
                        </article>
                        <article class="suggestion-row nx-card">
                            <div>
                                <strong>Follow-up reminder</strong>
                                <span>You have not heard back from Canva.</span>
                            </div>
                            <button class="secondary-action" type="button">Create Task</button>
                        </article>
                    </article>

                    <article class="add-application nx-card" aria-labelledby="add-application-title">
                        <div class="card-heading">
                            <div>
                                <h2 id="add-application-title">Add Application</h2>
                                <p>Capture the record before the details scatter.</p>
                            </div>
                            <button class="ghost-link" type="reset" form="application-form">Clear</button>
                        </div>

                        <form class="application-form" id="application-form">
                            <label>
                                <span>Company</span>
                                <input type="text" name="company" placeholder="Search companies...">
                            </label>
                            <label>
                                <span>Role</span>
                                <input type="text" name="role" placeholder="e.g. Software Engineer Intern">
                            </label>
                            <label>
                                <span>Location</span>
                                <input type="text" name="location" placeholder="e.g. Sydney, Australia">
                            </label>
                            <label>
                                <span>Type</span>
                                <select name="type">
                                    <option>SWE Internship</option>
                                    <option>Graduate Role</option>
                                    <option>Part-Time</option>
                                    <option>Hospitality</option>
                                </select>
                            </label>
                            <label>
                                <span>Status</span>
                                <select name="status">
                                    <option>Applied</option>
                                    <option>OA</option>
                                    <option>Interview</option>
                                    <option>Final Stage</option>
                                    <option>Offer</option>
                                    <option>Rejected</option>
                                </select>
                            </label>
                            <label>
                                <span>Database</span>
                                <select name="database">
                                    <option>SWE Internships</option>
                                    <option>Graduate Roles</option>
                                    <option>Part-Time</option>
                                    <option>Hospitality</option>
                                </select>
                            </label>
                            <button class="primary-action save-application" type="submit">Save Application</button>
                        </form>
                    </article>
                </aside>
            </section>

            <%- include("../../partials/system-settings") %>
        </main>

        <script src="/client/app-storage.js"></script>
        <script src="/client/shared/feedback.js"></script>
        <script src="/client/shared/settings-modal.js"></script>
        <script src="/client/features/JobApplications/job-applications.js"></script>
    </body>
</html>
